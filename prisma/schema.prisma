generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  role          Role     @default(user)
  email         String
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  App           App[]
  builderMine   Builder? @relation("builderToOwner")
  builder       Builder? @relation("builderToUsers", fields: [builderDomain], references: [domain])
  builderDomain String?

  @@unique([email, builderDomain])
}

model Builder {
  id          Int      @id @default(autoincrement())
  name        String
  domain      String   @unique
  companyName String?
  icon        String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("builderToOwner", fields: [ownerId], references: [id])
  ownerId     Int      @unique
  users       User[]   @relation("builderToUsers")
}

model App {
  id         Int        @id @default(autoincrement())
  name       String
  website    String
  appId      String
  lang       String
  userAgent  String?
  assets     AppAsset?
  design     AppDesign?
  navigation Link[]     @relation("mainNavigationToLinks")
  owner      User       @relation(fields: [ownerId], references: [id])
  ownerId    Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  appBuilds  AppBuild[]
}

model AppBuild {
  id              Int              @id @default(autoincrement())
  status          AppBuildStatus   @default(waiting)
  url             String?
  appBuildVersion Int?
  appVersion      String?
  platform        AppBuildPlatform @default(android)
  data            Json?
  App             App?             @relation(fields: [appId], references: [id])
  appId           Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AppDesign {
  id                     Int               @id @default(autoincrement())
  themeColor             String            @default("#ffffff")
  titleTheme             ThemeMode         @default(light)
  progressIndicator      ProgressIndicator @default(notUsed)
  disblayPagetitle       Boolean           @default(true)
  progressIndicatorColor String            @default("#3F51B5")
  pullToRefresh          Boolean           @default(true)
  activeTabColor         String            @default("#3F51B5")
  navigationActiveColor  String            @default("#3F51B5")
  layoutTemplate         LayoutTemplate    @default(bar)
  App                    App?              @relation(fields: [appId], references: [id])
  appId                  Int?              @unique
  AppDesignDrawer        AppDesignDrawer?
}

model AppDesignDrawer {
  id              Int        @id @default(autoincrement())
  color           String     @default("#3F51B5")
  textTheme       ThemeMode  @default(light)
  drawerMode      DrawerMode @default(notUsed)
  displayLogo     Boolean    @default(true)
  title           String?
  subTitle        String?
  backgroundImage String?
  logo            String?
  AppDesign       AppDesign  @relation(fields: [appId], references: [appId])
  appId           Int        @unique
}

model Link {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  data      Json?
  type      LinkType @default(link)
  app       App      @relation("mainNavigationToLinks", fields: [appid], references: [id])
  appid     Int
  menuType  MenuType @default(main)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppAsset {
  id              Int        @id @default(autoincrement())
  splashMode      SplashMode @default(color)
  color           String
  textThemeMode   ThemeMode  @default(light)
  displayLogo     Boolean    @default(true)
  tagLine         String?
  delay           Float?
  backgroundImage String?
  logo            String?
  appIcon         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  App             App        @relation(fields: [appid], references: [id])
  appid           Int        @unique
}

enum Role {
  admin
  user
  superAdmin
}

enum SplashMode {
  image
  color
}

enum ThemeMode {
  light
  dark
}

enum LinkType {
  link
  externalLink
  share
  sendEmail
  callPhone
  openModal
}

enum MenuType {
  main
  bar
  modal
}

enum LayoutTemplate {
  drawerBar
  tabBar
  bar
  blank
}

enum ProgressIndicator {
  notUsed
  linear
  circular
}

enum DrawerMode {
  notUsed
  image
  color
}

enum AppBuildStatus {
  waiting
  success
  failed
}

enum AppBuildPlatform {
  android
  ios
}
