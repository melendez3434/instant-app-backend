{
  "expo": {
    "name": "test",
    "slug": "app-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "previewer.now.app",
      "supportsTablet": true
    },

    "android": {
      "package": "previewer.now.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "appId": 1,
      "isPreview": true,
      "isDev": true,
      "eas": {
        "projectId": "f9e1b32d-44c4-4e8a-9996-f1b540ff6105"
      }
    }
  }
}
