{
  "name": "with-prisma",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "build:reflection": "NEXUS_SHOULD_EXIT_AFTER_REFLECTION=true ts-node ./src/api/schema",
    "dev": "env-cmd -f ./config/dev.env ts-node-dev --transpile-only ./src/api/app",
    "dev:migrate": "env-cmd -f ./config/dev.env prisma  db push  ",
    "dev:typecheck": "tsc --watch --noEmit",
    "format": "npx prettier --write './**/*.{ts,md}'",
    "start": "node build/api/app",
    "data:seed": "env-cmd -f ./config/dev.env ts-node src/seed/index.ts",
    "data:mainSeed": " ts-node src/seed/mainSeed.ts",
    "server": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "playground": "graphql playground",
    "prisma": "prisma",
    "graphql": "graphql",
    "build": "rm -rf build &&  yarn -s generate && tsc",
    "buildDev": "env-cmd -f ./config/dev.env rm -rf build &&  yarn -s generate && tsc",
    "style": "prettier --write 'src/**/*'",
    "generate": "yarn -s generate:prisma && yarn -s generate:nexus",
    "generate:prisma": "prisma generate",
    "generate:nexus": "NODE_ENV=development ts-node --transpile-only ./src/api/schema",
    "admin": "env-cmd -f ./config/dev.env  prisma studio"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "@graphql-tools/schema": "^8.3.11",
    "@paljs/plugins": "^4.0.8",
    "@prisma/client": "3.14.0",
    "@sendgrid/mail": "^7.7.0",
    "apollo-server-core": "^3.7.0",
    "apollo-server-express": "^3.7.0",
    "axios": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.27.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cron-job-manager": "^2.3.1",
    "eas-cli": "^2.8.0",
    "expo-cli": "^6.0.8",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.17.1",
    "express-rate-limit": "^5.5.1",
    "express-session": "^1.17.2",
    "express-slow-down": "^1.4.0",
    "form-data": "^4.0.0",
    "graphql": "^16.5.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-middleware": "^6.1.12",
    "graphql-scalars": "^1.13.6",
    "graphql-shield": "^7.5.0",
    "graphql-validation-complexity": "^0.4.2",
    "helmet": "^4.6.0",
    "intercom-client": "^4.0.0",
    "jsonwebtoken": "^8.5.1",
    "make-promises-safe": "^5.1.0",
    "moment": "^2.29.4",
    "nexpect": "^0.6.0",
    "nexus": "^1.3.0",
    "nexus-plugin-prisma": "^0.35.0",
    "node-cmd": "^5.0.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "rate-limit-redis": "^2.1.0",
    "shell": "^0.9.4",
    "shelljs": "^0.8.5",
    "slug-arabic": "^1.0.0",
    "stripe": "^10.17.0",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.2",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^8.5.6",
    "@types/node": "^18.7.15",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "env-cmd": "^10.1.0",
    "faker": "^5.5.3",
    "graphql-request": "^3.6.1",
    "prettier": "2.4.1",
    "prisma": "^3.14.0",
    "ts-node-dev": "^1.1.1"
  }
}
